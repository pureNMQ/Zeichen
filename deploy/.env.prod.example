# 贼船 Zeichen — 生产环境变量清单(占位符)。
# 用法:cp deploy/.env.prod.example .env,逐项替换后保持 .env 不入 git(chmod 600)。
# 启动:docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build
# 标 [必填] 的变量缺失时 compose 直接启动失败(${VAR:?} 守卫);其余有安全默认或可留空。
# 生成随机值:openssl rand -hex 32

# ---- 必填 ----
# 会话 JWT 密钥(>=32 字节随机串)
SESSION_SECRET=replace-with-openssl-rand-hex-32

# 业务库 postgres 密码(与 POSTGRES_PASSWORD 相同的变量会被 api/mcp/worker 复用)
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# 前端公开地址(设密链接、cookie 判定用)
WEB_BASE_URL=https://zeichen.example.com

# v2 project files. Size and quota should be confirmed against storage capacity.
FILE_LIBRARY_MAX_FILE_BYTES=268435456
FILE_LIBRARY_PROJECT_QUOTA_BYTES=4294967296
FILE_LIBRARY_GRANT_TTL_SECONDS=900

# MCP 公网 Host 白名单:必须含 <域名> 与 <域名>:443(nginx /mcp 的 Host 带端口转发)
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,zeichen.example.com,zeichen.example.com:443

# MCP OAuth 元数据端点公布的公开 URL(见 backend/.env.example 说明)
MCP_ISSUER_URL=https://zeichen.example.com/zeichen
MCP_RESOURCE_SERVER_URL=https://zeichen.example.com/mcp

# ---- 可选 ----
# 备份脚本用(异地 COS):见 deploy/docs/first-deploy.md §7 与 deploy/backup.sh
# COS_BUCKET=zeichen-backup-1250000000
# COS_REGION=ap-guangzhou
