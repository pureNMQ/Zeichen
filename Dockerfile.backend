# 贼船 Zeichen 后端容器(API / MCP / 记忆蒸馏 worker 共用镜像)
# 构建上下文 = 仓库根;entrypoint 由 compose 按服务指定。
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/zeichen

# 构建参数:可指向内网 PyPI 镜像(--build-arg PIP_INDEX_URL=https://<mirror>/simple)
ARG PIP_INDEX_URL=https://pypi.org/simple

# HTTP 镜像源(如腾讯云内网 mirrors.tencentyun.com)需显式信任,否则被 pip 忽略
ARG PIP_TRUSTED_HOST=

COPY backend/pyproject.toml ./
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./

RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" ${PIP_TRUSTED_HOST:+--trusted-host "${PIP_TRUSTED_HOST}"} .

# restart-worker 服务经只读 docker.sock 以服务端固定 argv 调宿主 `docker compose`
# 重建 cognee 容器:仅需 CLI 与 compose v2 插件(Debian trixie 官方源自带,
# 兼容 cognee 服务的 env_file.required 长语法),不安装 daemon。受限网络请先
# 将 /etc/apt/sources.list*.d 换成国内镜像源再构建。
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker-cli docker-compose \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 8000

# API 服务默认入口:先跑迁移再起服务。mcp / worker 服务在 compose 里覆盖 command。
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
