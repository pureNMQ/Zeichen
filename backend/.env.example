# 复制为 .env 后按需修改。postgres 凭据须与 docker-compose.yml 一致。
# 本地无容器开发/测试可覆盖: DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://zeichen:zeichen@localhost:5432/zeichen

# 会话 JWT 密钥(生产必须改为随机长字符串,>=32 字节);HTTPS 下置 True
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
SESSION_COOKIE_SECURE=False

# 供成员一次性设密链接使用的前端公开地址
WEB_BASE_URL=http://localhost:5173
