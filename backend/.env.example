# 复制为 .env 后按需修改。postgres 凭据须与 docker-compose.yml 一致。
# 一键启动脚本会始终使用此 PostgreSQL 连接；不要配置 SQLite 连接。
DATABASE_URL=postgresql+psycopg://zeichen:zeichen@localhost:5432/zeichen

# 会话 JWT 密钥(生产必须改为随机长字符串,>=32 字节);HTTPS 下置 True
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
SESSION_COOKIE_SECURE=False

# 供成员一次性设密链接使用的前端公开地址
WEB_BASE_URL=http://localhost:5173

# Cognee runs in Docker but is consumed by the host-launched API/MCP processes.
# If those processes later move into the Compose network, use http://cognee:8000/api/v1 instead.
COGNEE_BASE_URL=http://localhost:8000/api/v1
# Cognee is multi-tenant by default, so Zeichen uses one internal service
# identity.  For production, set a pre-provisioned COGNEE_SERVICE_API_KEY and
# replace/remove the password values.  Local development can bootstrap this
# account on its first memory write.
COGNEE_SERVICE_API_KEY=
COGNEE_SERVICE_EMAIL=zeichen-service@example.com
COGNEE_SERVICE_PASSWORD=zeichen-local-cognee-service-password

# Streamable HTTP MCP DNS-rebinding protection. Keep this enabled unless an
# upstream proxy performs equivalent Host/Origin validation. Values are parsed
# as booleans by Pydantic (for example: false to explicitly turn it off).
MCP_ENABLE_DNS_REBINDING_PROTECTION=True

# Comma-separated Host headers accepted by the MCP endpoint while protection is
# enabled. Add the externally visible hostname used by a reverse proxy, e.g.
# MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,mcp.example.com,mcp.example.com:443
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
